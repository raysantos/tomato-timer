{
  "name": "Tomato Timer",
  "short_name": "Tomato",
  "description": "A Pomodoro timer for focus sessions and breaks.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f4f1",
  "theme_color": "#d8402b",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
